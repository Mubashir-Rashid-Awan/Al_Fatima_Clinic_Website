# =====================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, it will never be committed.
# =====================================================================

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Project Settings -> API -> service_role key
# SECRET — never expose this in client-side code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (resend.com) -> API Keys
RESEND_API_KEY=re_your-resend-api-key

# The email address confirmation emails are sent FROM.
# Use onboarding@resend.dev for immediate testing, or your own
# verified domain (e.g. bookings@yourclinic.com) for production.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Full public URL of the deployed site (used in email links).
# Use http://localhost:3000 during local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
